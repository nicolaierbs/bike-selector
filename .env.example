# ---- Strava API application (https://www.strava.com/settings/api) ----
STRAVA_CLIENT_ID=123456
STRAVA_CLIENT_SECRET=replace-me

# Obtained once via: uv run bike-selector auth
STRAVA_REFRESH_TOKEN=replace-me

# ---- Webhook ----
# Random string you invent. Strava echoes it back during subscription validation.
WEBHOOK_VERIFY_TOKEN=change-this-to-something-random
# Random slug that makes the callback URL unguessable. Callback path becomes
# /webhook/<WEBHOOK_PATH_SECRET>. Leave empty to serve plain /webhook.
WEBHOOK_PATH_SECRET=
# Public base URL of the deployed service, no trailing slash.
PUBLIC_BASE_URL=https://bike-selector.onrender.com

# ---- Behaviour ----
# Assign the winning bike to the activity.
SET_GEAR=true
# Append the probability line to the activity description.
WRITE_DESCRIPTION=true
# Reassign even when the activity already has a bike attached.
OVERWRITE_EXISTING_GEAR=true
# Skip auto-assign below this probability (0.0 disables the gate; the
# probability line is still written).
MIN_CONFIDENCE=0.0
# Ignore indoor/trainer rides.
SKIP_TRAINER=false
# Marker appended to descriptions so the app can recognise its own edits.
DESCRIPTION_MARKER=[bike-selector]
# Number of bikes listed in the description line.
MAX_PROBABILITIES_SHOWN=3

# ---- Title ----
# Replace Strava's generic default title ("Morning Ride", "Lunch Ride", ...)
# with a German one, e.g. "Entspannte Rennrad-Tour über Bergstraße".
RENAME_TITLE=true
# Also replace a title the rider typed themselves, not just Strava's default.
OVERWRITE_EXISTING_TITLE=false
# JSON object mapping each bike's gear_id to the German category word used in
# the title. A bike missing from this map falls back to its own Strava name.
BIKE_TYPES={"b111": "Rennrad", "b222": "Gravel"}
# How many of the ride's longest climb segments to name in the title.
CLIMB_SEGMENTS_IN_TITLE=2
# Minimum average grade (%) for a segment effort to count as a climb.
CLIMB_MIN_GRADE=3.0

# ---- Model ----
# How many past activities to pull for training.
TRAINING_ACTIVITY_LIMIT=1000
# Retrain when the cached model is older than this.
MODEL_TTL_HOURS=24
# Recency weighting: rides this many days old count half as much.
RECENCY_HALF_LIFE_DAYS=365
# Ignore bikes with fewer than this many labelled rides.
MIN_RIDES_PER_BIKE=5

# ---- Runtime ----
# Ephemeral scratch dir for the cached model and token.
STATE_DIR=/tmp/bike-selector
# Self-ping interval to stop Render's free tier idling out. 0 disables.
KEEPALIVE_MINUTES=10
LOG_LEVEL=INFO
